    "ValidIssuer": "Kairos.API",
    "ValidAudience": "Kairos.Users",
    "TokenValidityInMinutes":  1440,
    "RefreshTokenValidityInMinutes": 7
  },
  "UserMaster": {
    "UserName": "master",
