{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=kairos;Username=postgres;Password=123456  ",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "jwt": {
    "SecretKey": "475643657c3f573rfheyf734fg3qgf7nrg34687qotr4gngq3o47324322340qat47fyt43qronfaqorf7vpq734q37cntc6gr348r4",
    "ValidIssuer": "Kairos.API",
    "ValidAudience": "Kairos.Users",
    "TokenValidityInMinutes":  1440,
    "RefreshTokenValidityInMinutes": 7
  },
  "UserMaster": {
    "UserName": "master",
    "Email": "master.kairos@gmail.com",
    "FullName": "Kairos Master",
    "Password": "433486537654376FBFTbttdFRrdv$%77GGgd"
  },
  "ApiBehavior": {
    "SuppressMapClientErrors": true,
    "SuppressModelStateInvalidFilter": false
  },
  "JwtAuthentication": {
    "MapInboundClaims": false,
    "ClockSkewSeconds": 0,
    "NameClaimType": "name",
    "RoleClaimType": "role"
  },
  "Postgres": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 7,
    "CommandTimeoutSeconds": 30,
    "EnableLocking": true
  },
  "Redis": {
    "AbortOnConnectFail": false,
    "ConnectRetry": 3,
    "ConnectTimeoutMilliseconds": 5000,
    "SyncTimeoutMilliseconds": 5000,
    "AsyncTimeoutMilliseconds": 5000,
    "ClientName": "Kairos.Api"
  },
  "SecondLevelCache": {
    "CacheKeyPrefix": "Kairos_EF_",
    "CacheExpirationMinutes": 5,
    "CacheProviderRetryMinutes": 1,
    "LockMode": "Keyed",
    "LockTimeoutSeconds": 15
  },
  "ApiVersioning": {
    "DefaultMajorVersion": 1,
    "DefaultMinorVersion": 0,
    "AssumeDefaultVersionWhenUnspecified": true,
    "ReportApiVersions": true,
    "GroupNameFormat": "'v'VVV",
    "SubstituteApiVersionInUrl": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Observability": {
    "Enabled": true,

    "ServiceName": "kairos-api",
    "ServiceNamespace": "Kairos",
    "ServiceVersion": "1.0.0",

    "OtlpEndpoint": "http://localhost:4317",
    "Protocol": "Grpc",
    "ExportTimeoutMilliseconds": 10000,
    "MetricExportIntervalMilliseconds": 15000,

    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableLogs": true,

    "TraceSamplingRatio": 1.0,

    "EnableAspNetCoreInstrumentation": true,
    "EnableHttpClientInstrumentation": true,
    "EnableRuntimeInstrumentation": true,
    "EnablePostgreSqlInstrumentation": true,
    "EnableRedisInstrumentation": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Accept",
      "Authorization",
      "Content-Type",
      "X-Inbox-Id"
    ],
    "ExposedHeaders": [],
    "AllowCredentials": false,
    "PreflightMaxAgeSeconds": 600
  },
  "RateLimiting": {
    "Enabled": true,
    "ExemptPaths": [ "/health", "/swagger" ],

    "Global":            { "PermitLimit": 350, "WindowSeconds": 60 },
    "GlobalWrite":       { "PermitLimit": 80,  "WindowSeconds": 60 },

    "AuthLogin":         { "PermitLimit": 20,  "WindowSeconds": 60, "SegmentsPerWindow": 6 },
    "AuthRegister":      { "PermitLimit": 10,   "WindowSeconds": 3600 },
    "AuthRefresh":       { "PermitLimit": 70,  "WindowSeconds": 60 },
    "AuthLookup":        { "PermitLimit": 30,  "WindowSeconds": 60 },

    "ChangePassword":    { "PermitLimit": 5,   "WindowSeconds": 900 },
    "AccountDelete":     { "PermitLimit": 5,   "WindowSeconds": 3600 },
    "ReservationCreate": { "PermitLimit": 20,  "WindowSeconds": 60 },
    "Availability":      { "PermitLimit": 80,  "WindowSeconds": 60 },
    "CheckIn":           { "PermitLimit": 30,  "WindowSeconds": 60 },
    "FeedbackCreate":    { "PermitLimit": 20,  "WindowSeconds": 3600 },
    "Admin":             { "PermitLimit": 60,  "WindowSeconds": 60 },
    "HeavyRead":         { "PermitLimit": 80,  "WindowSeconds": 60 }
  },
  "Storage": {
    "Enabled": true,
    "ServiceUrl": "http://localhost:9000",
    "PublicUrl": null,
    "Region": "us-east-1",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": true,
    "EnsureBucketsOnStartup": true,
    "MaxErrorRetry": 3,
    "TimeoutSeconds": 60,
    "PresignedUrlExpirationMinutes": 15,
    "Buckets": {
      "RoomMedia": "kairos-room-media",
      "SupportMaterials": "kairos-support-materials"
    },
    "Limits": {
      "MaxPhotoBytes": 5242880,
      "MaxFloorPlanBytes": 10485760,
      "MaxSupportMaterialBytes": 26214400
    }
  }
}
