  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=kairos;Username=postgres;Password=123456  ",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "jwt": {
